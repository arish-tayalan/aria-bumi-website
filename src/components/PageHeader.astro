---
interface Props {
  title: string;
  sub?: string;
}
const { title, sub } = Astro.props;
---

<section class="border-b border-gray-200 bg-brand-50">
  <div class="mx-auto max-w-6xl px-4 py-10 sm:py-14">
    <h1 class="text-3xl font-bold text-gray-900 sm:text-4xl">{title}</h1>
    {sub && <p class="mt-2 max-w-2xl text-lg text-gray-600">{sub}</p>}
    <slot />
  </div>
</section>
