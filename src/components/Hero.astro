---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { company, waLink } from '../data/company';
import { hero, heroLayout } from '../data/hero';
import { t } from '../i18n/en';

const split = heroLayout === 'split';

// Never generate sizes above the source's native width (no build-time upscaling).
const native = hero.image.width;
const bgWidths = [...[640, 1024, 1600, 1920].filter((w) => w < native), native];
---

<section
  class:list={['text-white', split ? 'bg-brand-600' : 'relative isolate overflow-hidden bg-brand-900']}
>
  {
    !split && (
      <>
        <Image
          src={hero.image}
          alt={hero.alt}
          widths={bgWidths}
          sizes="100vw"
          class="absolute inset-0 -z-20 size-full object-cover"
          loading="eager"
          fetchpriority="high"
        />
        <div class="absolute inset-0 -z-10 bg-gradient-to-r from-brand-900/95 via-brand-900/90 to-brand-900/70" />
      </>
    )
  }

  <div
    class:list={[
      'mx-auto max-w-6xl px-4',
      split ? 'grid items-center gap-10 py-12 sm:py-16 lg:grid-cols-2 lg:gap-12 lg:py-20' : 'py-16 sm:py-24 lg:py-32',
    ]}
  >
    <div>
      <p class="text-sm font-semibold uppercase tracking-widest text-accent-400">{company.name}</p>
      <h1 class="mt-3 max-w-3xl text-3xl font-extrabold leading-tight sm:text-5xl">{t.hero.headline}</h1>
      <p class="mt-4 max-w-2xl text-base text-gray-100 sm:text-lg">{t.hero.sub}</p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a
          href={waLink()}
          class="inline-flex h-12 items-center justify-center gap-2 rounded-lg bg-whatsapp px-6 text-base font-semibold text-white hover:brightness-95"
        >
          <Icon name="message-circle" class="size-5" />
          {t.cta.whatsappUs}
        </a>
        <a
          href="/projects"
          class="inline-flex h-12 items-center justify-center gap-2 rounded-lg border-2 border-white/70 px-6 text-base font-semibold text-white hover:bg-white/10"
        >
          {t.cta.viewProjects}
          <Icon name="arrow-right" class="size-5" />
        </a>
      </div>
    </div>

    {
      split && (
        <div class="lg:justify-self-end">
          <Image
            src={hero.image}
            alt={hero.alt}
            widths={[360, 540, 676]}
            sizes="(min-width: 1024px) 552px, calc(100vw - 2rem)"
            class="h-auto w-full max-w-[676px] rounded-2xl shadow-xl ring-1 ring-white/20"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      )
    }
  </div>
</section>
