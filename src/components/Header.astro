---
import { Image } from 'astro:assets';
import logo from '../assets/logo/aria-logo-from-pdf.jpg';
import Icon from './Icon.astro';
import { company, waLink } from '../data/company';
import { t } from '../i18n/en';

const nav = [
  { href: '/about', label: t.nav.about },
  { href: '/services', label: t.nav.services },
  { href: '/projects', label: t.nav.projects },
  { href: '/certifications', label: t.nav.certifications },
  { href: '/contact', label: t.nav.contact },
];
const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(href + '/');
---

<header class="sticky top-0 z-40 border-b border-gray-200 bg-white/95 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-3 px-4">
    <a href="/" class="flex min-w-0 items-center gap-2.5" aria-label={`${company.name} home`}>
      <Image src={logo} alt="" width={40} height={44} class="h-10 w-auto" loading="eager" />
      <span class="truncate text-base font-bold leading-tight text-brand-600 sm:text-lg">{company.name}</span>
    </a>

    <nav class="hidden items-center gap-6 lg:flex" aria-label="Main">
      {
        nav.map((n) => (
          <a
            href={n.href}
            aria-current={isActive(n.href) ? 'page' : undefined}
            class:list={[
              'text-sm font-medium hover:text-brand-600',
              isActive(n.href) ? 'text-brand-600' : 'text-gray-700',
            ]}
          >
            {n.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <a
        href={waLink()}
        class="inline-flex h-11 items-center gap-2 rounded-lg bg-whatsapp px-3 text-sm font-semibold text-white hover:brightness-95 sm:px-4"
      >
        <Icon name="message-circle" class="size-5" />
        <span class="hidden min-[400px]:inline">{t.cta.whatsapp}</span>
        <span class="sr-only min-[400px]:hidden">{t.cta.whatsapp}</span>
      </a>
      <button
        type="button"
        id="menu-toggle"
        class="inline-flex size-11 items-center justify-center rounded-lg border border-gray-300 text-gray-700 lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label={t.nav.menu}
        data-open-label={t.nav.menu}
        data-close-label={t.nav.closeMenu}
      >
        <span data-icon="open"><Icon name="menu" /></span>
        <span data-icon="close" class="hidden"><Icon name="x" /></span>
      </button>
    </div>
  </div>

  <nav id="mobile-menu" class="hidden border-t border-gray-200 bg-white lg:hidden" aria-label="Mobile">
    <ul class="mx-auto max-w-6xl px-4 py-2">
      {
        nav.map((n) => (
          <li>
            <a
              href={n.href}
              aria-current={isActive(n.href) ? 'page' : undefined}
              class:list={[
                'block rounded-lg px-2 py-3 text-base font-medium',
                isActive(n.href) ? 'text-brand-600' : 'text-gray-800',
              ]}
            >
              {n.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  const btn = document.getElementById('menu-toggle') as HTMLButtonElement | null;
  const menu = document.getElementById('mobile-menu');
  if (btn && menu) {
    const set = (open: boolean) => {
      menu.classList.toggle('hidden', !open);
      btn.setAttribute('aria-expanded', String(open));
      btn.setAttribute('aria-label', (open ? btn.dataset.closeLabel : btn.dataset.openLabel) ?? '');
      btn.querySelector('[data-icon="open"]')?.classList.toggle('hidden', open);
      btn.querySelector('[data-icon="close"]')?.classList.toggle('hidden', !open);
    };
    btn.addEventListener('click', () => set(btn.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') set(false);
    });
  }
</script>
