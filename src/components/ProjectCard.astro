---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { isCollage as isCollageImage } from '../lib/gallery';
import { t } from '../i18n/en';

interface Props {
  project: CollectionEntry<'projects'>;
  /** Heading level for the card title, so the page's heading order stays valid. */
  headingLevel?: 'h2' | 'h3';
}
const { project, headingLevel: Heading = 'h3' } = Astro.props;
const { title, category, cover } = project.data;
// Collages must never be cropped, so they sit whole inside the frame.
const isCollage = isCollageImage(cover);
---

<a
  href={`/projects/${project.id}`}
  class="group flex h-full flex-col overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm transition hover:shadow-md"
>
  <div class="aspect-[4/3] overflow-hidden bg-gray-100">
    <Image
      src={cover}
      alt={`${title}: project photo`}
      widths={[360, 640, 800]}
      sizes="(min-width: 1024px) 384px, (min-width: 640px) 50vw, 100vw"
      class:list={['size-full', isCollage ? 'object-contain' : 'object-cover transition duration-300 group-hover:scale-105']}
      loading="lazy"
    />
  </div>
  <div class="p-4">
    <p class="text-xs font-semibold uppercase tracking-wide text-accent-500">{t.categories[category]}</p>
    <Heading class="mt-1 text-lg font-semibold text-gray-900 group-hover:text-brand-600">{title}</Heading>
  </div>
</a>
