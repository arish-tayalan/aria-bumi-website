---
import Icon from './Icon.astro';
import { company, formatAddress, telHref } from '../data/company';
import { t } from '../i18n/en';

const links = [
  { href: '/about', label: t.nav.about },
  { href: '/services', label: t.nav.services },
  { href: '/projects', label: t.nav.projects },
  { href: '/certifications', label: t.nav.certifications },
  { href: '/contact', label: t.nav.contact },
];
---

<footer class="bg-brand-900 text-gray-200">
  <div class="mx-auto grid max-w-6xl gap-8 px-4 py-12 sm:grid-cols-2 lg:grid-cols-3">
    <div>
      <p class="text-lg font-bold text-white">{company.name}</p>
      <p class="mt-2 text-sm text-gray-300">{company.tagline}</p>
      <p class="mt-3 text-sm text-gray-300">{t.footer.ssm} {company.ssmNo}</p>
    </div>

    <div>
      <h2 class="text-sm font-semibold uppercase tracking-wide text-accent-400">{t.footer.contact}</h2>
      <ul class="mt-3 space-y-3 text-sm">
        <li class="flex gap-2">
          <Icon name="map-pin" class="mt-0.5 size-4 shrink-0 text-accent-400" />
          <address class="not-italic">{formatAddress()}</address>
        </li>
        {
          company.phones.map((p) => (
            <li class="flex gap-2">
              <Icon name="phone" class="mt-0.5 size-4 shrink-0 text-accent-400" />
              <a href={telHref(p.number)} class="py-1 hover:text-white">
                {p.number} <span class="text-gray-400">({p.label})</span>
              </a>
            </li>
          ))
        }
        <li class="flex gap-2">
          <Icon name="mail" class="mt-0.5 size-4 shrink-0 text-accent-400" />
          <a href={`mailto:${company.email}`} class="py-1 break-all hover:text-white">{company.email}</a>
        </li>
      </ul>
    </div>

    <div>
      <h2 class="text-sm font-semibold uppercase tracking-wide text-accent-400">{t.footer.links}</h2>
      <ul class="mt-3 space-y-1 text-sm">
        {
          links.map((l) => (
            <li>
              <a href={l.href} class="inline-block py-1.5 hover:text-white">{l.label}</a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="border-t border-white/10 py-4 text-center text-xs text-gray-400">
    &copy; {new Date().getFullYear()} {company.name}. {t.footer.rights}
  </div>
</footer>
