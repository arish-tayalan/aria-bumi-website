---
import Icon from './Icon.astro';
import { primaryPhone, telHref, waLink } from '../data/company';
import { t } from '../i18n/en';

interface Props {
  variant?: 'light' | 'dark';
  message?: string;
}
const { variant = 'light', message } = Astro.props;
---

<div class="flex flex-col gap-3 sm:flex-row">
  <a
    href={waLink(message)}
    class="inline-flex h-12 items-center justify-center gap-2 rounded-lg bg-whatsapp px-6 text-base font-semibold text-white hover:brightness-95"
  >
    <Icon name="message-circle" class="size-5" />
    {t.cta.whatsappUs}
  </a>
  <a
    href={telHref(primaryPhone.number)}
    class:list={[
      'inline-flex h-12 items-center justify-center gap-2 rounded-lg border-2 px-6 text-base font-semibold',
      variant === 'dark'
        ? 'border-white/70 text-white hover:bg-white/10'
        : 'border-brand-600 text-brand-600 hover:bg-brand-50',
    ]}
  >
    <Icon name="phone" class="size-5" />
    {t.cta.call}
  </a>
</div>
