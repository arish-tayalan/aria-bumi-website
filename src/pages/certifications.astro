---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import GalleryImage from '../components/GalleryImage.astro';
import Lightbox from '../components/Lightbox.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { certificates, company } from '../data/company';
import { warnIfExpiring } from '../lib/expiry';
import type { GalleryItem } from '../lib/gallery';
import { t } from '../i18n/en';
import stCert from '../assets/certificates/st-electrical-contractor-cert.jpg';
import cidbCert from '../assets/certificates/cidb-registration-cert.jpg';

const { st, cidb, other } = certificates;

warnIfExpiring('Suruhanjaya Tenaga registration', st.validUntil);
warnIfExpiring('CIDB registration', cidb.validUntil);

const doc = (image: ImageMetadata, alt: string): GalleryItem => ({ image, kind: 'document', phase: null, alt, caption: alt });
const stItem = doc(stCert, `Suruhanjaya Tenaga registration certificate (Class C) for ${company.name}`);
const cidbItem = doc(cidbCert, `CIDB registration certificate (Grade G3) for ${company.name}`);

const cards = [
  {
    title: t.certs.stTitle,
    sub: st.title,
    item: stItem,
    rows: [
      { label: t.certs.regNo, value: st.regNo },
      { label: t.certs.class, value: st.class.replace('Class ', '') },
      { label: t.certs.validity, value: t.certs.validFromUntil(st.validFrom, st.validUntil) },
    ],
  },
  {
    title: t.certs.cidbTitle,
    sub: t.certs.cidbSub,
    item: cidbItem,
    rows: [
      { label: t.certs.regNo, value: cidb.regNo },
      { label: t.certs.grade, value: t.certs.cidbGrade },
      { label: t.certs.validity, value: t.certs.validFromUntil(cidb.validFrom, cidb.validUntil) },
    ],
  },
];
---

<Base
  title="Certifications | ST and CIDB Registered Contractor"
  description="Aria Bumi Resources is a registered electrical contractor with Suruhanjaya Tenaga (Class C) and CIDB Malaysia (Grade G3) in Johor Bahru."
>
  <PageHeader title={t.certs.title} sub={t.certs.sub} />

  <section class="mx-auto max-w-6xl px-4 py-14">
    <div class="grid gap-6 lg:grid-cols-2">
      {
        cards.map((c) => (
          <article class="flex flex-col gap-5 rounded-2xl border border-gray-200 bg-white p-5 shadow-sm sm:flex-row">
            <div class="min-w-0 flex-1">
              <span class="inline-flex size-11 items-center justify-center rounded-lg bg-brand-50 text-brand-600">
                <Icon name="badge-check" class="size-6" />
              </span>
              <h2 class="mt-3 text-lg font-bold text-gray-900">{c.title}</h2>
              <p class="text-sm text-gray-500">{c.sub}</p>
              <dl class="mt-4 space-y-3 text-sm">
                {c.rows.map((r) => (
                  <div>
                    <dt class="text-gray-500">{r.label}</dt>
                    <dd class="break-words font-semibold text-gray-900">{r.value}</dd>
                  </div>
                ))}
              </dl>
              <p class="mt-4 text-xs text-gray-500">{t.certs.viewCert}</p>
            </div>
            <div class="w-44 shrink-0 self-center sm:self-start">
              <GalleryImage item={c.item} group="certificates" />
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="bg-gray-50">
    <div class="mx-auto max-w-6xl px-4 py-14">
      <h2 class="text-2xl font-bold text-gray-900">{t.certs.tableTitle}</h2>
      <div class="mt-6 overflow-x-auto rounded-xl border border-gray-200 bg-white">
        <table class="w-full min-w-[480px] text-left text-sm">
          <caption class="sr-only">{t.certs.tableTitle}</caption>
          <thead class="bg-brand-50 text-gray-700">
            <tr>
              <th scope="col" class="px-4 py-3 font-semibold">{t.certs.grade}</th>
              <th scope="col" class="px-4 py-3 font-semibold">{t.certs.category}</th>
              <th scope="col" class="px-4 py-3 font-semibold">{t.certs.codes}</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            {
              cidb.grades.map((g) => (
                <tr>
                  <th scope="row" class="px-4 py-3 font-semibold text-gray-900">{g.grade}</th>
                  <td class="px-4 py-3 font-medium text-gray-900">{g.category}</td>
                  <td class="px-4 py-3">
                    <ul class="flex flex-wrap gap-1.5">
                      {g.codes.map((code) => (
                        <li class="rounded bg-gray-100 px-2 py-0.5 font-mono text-xs text-gray-800">{code}</li>
                      ))}
                    </ul>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="mt-3 text-sm text-gray-500">{t.certs.legend}</p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-14">
    <h2 class="text-2xl font-bold text-gray-900">{t.certs.otherTitle}</h2>
    <ul class="mt-4 space-y-2 text-gray-700">
      {
        other.map((o) => (
          <li class="flex gap-3">
            <Icon name="badge-check" class="mt-0.5 size-5 shrink-0 text-accent-500" />
            <span>
              {o.title} <span class="text-gray-500">({t.certs.validUntil} {o.validUntil})</span>
            </span>
          </li>
        ))
      }
    </ul>
    <p class="mt-4 text-sm text-gray-500">{t.certs.otherNote}</p>
  </section>

  <CtaBand />
  <Lightbox />
</Base>
