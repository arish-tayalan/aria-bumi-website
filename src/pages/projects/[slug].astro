---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Gallery from '../../components/Gallery.astro';
import BeforeAfter from '../../components/BeforeAfter.astro';
import Lightbox from '../../components/Lightbox.astro';
import CtaButtons from '../../components/CtaButtons.astro';
import Icon from '../../components/Icon.astro';
import { buildGallery, hasBeforeAfter } from '../../lib/gallery';
import { t } from '../../i18n/en';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { title, category, client, location, year, cover, images } = project.data;
const { Content } = await render(project);

const items = buildGallery(title, cover, images);
const beforeAfter = hasBeforeAfter(items);

const intro = (project.body ?? '').replace(/<!--[\s\S]*?-->/g, '').trim().split(/(?<=\.)\s/)[0];
const full = `${title}: ${intro}`;
// Keep meta descriptions within ~160 characters, cutting at a word boundary.
const description = full.length <= 160 ? full : `${full.slice(0, 157).replace(/\s+\S*$/, '')}...`;

const meta = [
  { label: t.projectDetail.client, value: client?.trim() },
  { label: t.projectDetail.location, value: location?.trim() },
  { label: t.projectDetail.year, value: year ? String(year) : '' },
].filter((m) => m.value);

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).href },
    { '@type': 'ListItem', position: 2, name: t.projectDetail.breadcrumbProjects, item: new URL('/projects', Astro.site).href },
    { '@type': 'ListItem', position: 3, name: title },
  ],
};
---

<Base title={title} description={description} extraJsonLd={[breadcrumb]}>
  <article class="mx-auto max-w-6xl px-4 py-10 sm:py-14">
    <nav aria-label="Breadcrumb" class="text-sm">
      <a href="/projects" class="inline-flex items-center gap-1 py-2 font-medium text-brand-600 hover:underline">
        <Icon name="arrow-right" class="size-4 rotate-180" />
        {t.projectDetail.back}
      </a>
    </nav>

    <header class="mt-4 max-w-3xl">
      <a
        href={`/projects?category=${category}`}
        class="inline-block rounded-full bg-accent-400/20 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-accent-500 hover:bg-accent-400/30"
      >
        {t.categories[category]}
      </a>
      <h1 class="mt-3 text-3xl font-bold text-gray-900 sm:text-4xl">{title}</h1>
      {
        meta.length > 0 && (
          <dl class="mt-4 flex flex-wrap gap-x-8 gap-y-2 text-sm">
            {meta.map((m) => (
              <div>
                <dt class="text-gray-500">{m.label}</dt>
                <dd class="font-medium text-gray-900">{m.value}</dd>
              </div>
            ))}
          </dl>
        )
      }
      <div class="richtext mt-6 text-lg"><Content /></div>
    </header>

    <section class="mt-10" aria-label={t.projectDetail.gallery}>
      {beforeAfter ? <BeforeAfter items={items} group="gallery" /> : <Gallery items={items} group="gallery" />}
    </section>
  </article>

  <section class="bg-brand-600 text-white">
    <div class="mx-auto flex max-w-6xl flex-col items-start gap-6 px-4 py-12 md:flex-row md:items-center md:justify-between">
      <div>
        <h2 class="text-2xl font-bold sm:text-3xl">{t.projectDetail.ctaTitle}</h2>
        <p class="mt-2 max-w-xl text-brand-100">{t.projectDetail.ctaText}</p>
      </div>
      <CtaButtons variant="dark" message={t.projectDetail.ctaMessage(title)} />
    </div>
  </section>

  <Lightbox />
</Base>
