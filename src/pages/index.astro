---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Icon from '../components/Icon.astro';
import CtaButtons from '../components/CtaButtons.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { services } from '../data/company';
import { t } from '../i18n/en';

const featured = (await getCollection('projects', (p) => p.data.featured)).sort((a, b) => a.data.order - b.data.order);

const clientLabel = { home: 'Home', shop: 'Shop', factory: 'Factory' } as const;
---

<Base
  title="Electrical Contractor Johor Bahru | Aria Bumi Resources"
  description="Aria Bumi Resources is a licensed electrical and mechanical engineering contractor in Johor Bahru: control panels, industrial wiring, generator sets, air compressors and lightning protection."
>
  <Hero />

  <!-- Trust strip -->
  <section class="border-b border-gray-200 bg-gray-50">
    <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-center gap-x-3 gap-y-1 px-4 py-4 text-center text-sm font-medium text-gray-700">
      <Icon name="shield-check" class="size-5 text-brand-600" />
      <span>{t.trust.prefix}</span>
      {
        t.trust.items.map((item, i) => (
          <>
            {i > 0 && <span aria-hidden="true" class="text-gray-400">&middot;</span>}
            <span class="font-semibold text-brand-600">{item}</span>
          </>
        ))
      }
    </div>
  </section>

  <!-- Services -->
  <section class="mx-auto max-w-6xl px-4 py-16">
    <h2 class="text-2xl font-bold text-gray-900 sm:text-3xl">{t.services.title}</h2>
    <p class="mt-2 max-w-2xl text-gray-600">{t.services.sub}</p>
    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        services.map((s) => (
          <a
            href={`/services#${s.slug}`}
            class="group flex flex-col rounded-xl border border-gray-200 bg-white p-5 shadow-sm transition hover:border-brand-500 hover:shadow-md"
          >
            <span class="inline-flex size-12 items-center justify-center rounded-lg bg-brand-50 text-brand-600">
              <Icon name={s.icon} class="size-6" />
            </span>
            <h3 class="mt-4 text-lg font-semibold text-gray-900">{s.title}</h3>
            <p class="mt-2 text-sm text-gray-600">{s.description}</p>
            <p class="mt-3 text-xs font-medium text-gray-500">
              {s.clients.map((c) => clientLabel[c]).join(' · ')}
            </p>
          </a>
        ))
      }
    </div>
  </section>

  <!-- Featured projects -->
  <section class="bg-gray-50">
    <div class="mx-auto max-w-6xl px-4 py-16">
      <h2 class="text-2xl font-bold text-gray-900 sm:text-3xl">{t.projects.title}</h2>
      <p class="mt-2 max-w-2xl text-gray-600">{t.projects.sub}</p>
      <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {featured.map((project) => <ProjectCard project={project} />)}
      </div>
      <div class="mt-8 text-center">
        <a
          href="/projects"
          class="inline-flex h-12 items-center justify-center gap-2 rounded-lg bg-brand-600 px-6 text-base font-semibold text-white hover:bg-brand-700"
        >
          {t.cta.viewAllProjects}
          <Icon name="arrow-right" class="size-5" />
        </a>
      </div>
    </div>
  </section>

  <!-- Why us -->
  <section class="mx-auto max-w-6xl px-4 py-16">
    <h2 class="text-2xl font-bold text-gray-900 sm:text-3xl">{t.why.title}</h2>
    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        t.why.items.map((item) => (
          <div>
            <span class="inline-flex size-12 items-center justify-center rounded-full bg-accent-400/20 text-accent-500">
              <Icon name={item.icon} class="size-6" />
            </span>
            <h3 class="mt-3 text-lg font-semibold text-gray-900">{item.title}</h3>
            <p class="mt-1 text-sm text-gray-600">{item.text}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- CTA band -->
  <section class="bg-brand-600 text-white">
    <div class="mx-auto flex max-w-6xl flex-col items-start gap-6 px-4 py-12 md:flex-row md:items-center md:justify-between">
      <div>
        <h2 class="text-2xl font-bold sm:text-3xl">{t.ctaBand.title}</h2>
        <p class="mt-2 max-w-xl text-brand-100">{t.ctaBand.text}</p>
      </div>
      <CtaButtons variant="dark" />
    </div>
  </section>
</Base>
