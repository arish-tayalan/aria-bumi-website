---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import GalleryImage from '../components/GalleryImage.astro';
import Lightbox from '../components/Lightbox.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { company, team } from '../data/company';
import type { GalleryItem } from '../lib/gallery';
import { t } from '../i18n/en';
import office1 from '../assets/office/office-01.jpg';
import office2 from '../assets/office/office-02.jpg';
import office3 from '../assets/office/office-03.jpg';
import office4 from '../assets/office/office-04.jpg';
import office5 from '../assets/office/office-05.jpg';

const office = (image: ImageMetadata, i: number): GalleryItem => ({
  image,
  kind: 'photo',
  phase: null,
  alt: t.about.officeAlt[i],
  caption: t.about.officeAlt[i],
});
// The two wide shots sit side by side on top; the three smaller ones sit below.
const wide = [office(office5, 4), office(office4, 3)];
const small = [office(office1, 0), office(office2, 1), office(office3, 2)];
---

<Base
  title="About Us | Electrical & Mechanical Contractor Johor Bahru"
  description="About Aria Bumi Resources (formerly Aria Electro Mech): a licensed electrical and mechanical engineering contractor at Arked Johor Jaya, Johor Bahru."
>
  <PageHeader title={t.about.title} sub={t.about.sub} />

  <!-- Story -->
  <section class="mx-auto max-w-6xl px-4 py-14">
    <div class="max-w-3xl">
      <h2 class="text-2xl font-bold text-gray-900 sm:text-3xl">{t.about.storyTitle}</h2>
      <p class="mt-3 inline-flex items-center gap-2 rounded-full bg-accent-400/20 px-3 py-1 text-sm font-semibold text-accent-500">
        <Icon name="badge-check" class="size-4" />
        {t.about.formerly}
      </p>
      <div class="mt-5 space-y-4 text-lg leading-relaxed text-gray-700">
        {t.about.story.map((p) => <p>{p}</p>)}
      </div>
    </div>
  </section>

  <!-- Vision and mission -->
  <section class="bg-gray-50">
    <div class="mx-auto grid max-w-6xl gap-6 px-4 py-14 md:grid-cols-2">
      <div class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm">
        <h2 class="text-xl font-bold text-brand-600">{t.about.visionTitle}</h2>
        <p class="mt-3 text-gray-700">{company.vision}</p>
      </div>
      <div class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm">
        <h2 class="text-xl font-bold text-brand-600">{t.about.missionTitle}</h2>
        <p class="mt-3 text-gray-700">{company.mission}</p>
      </div>
    </div>
  </section>

  <!-- Team -->
  <section class="mx-auto max-w-6xl px-4 py-14">
    <h2 class="text-2xl font-bold text-gray-900 sm:text-3xl">{t.about.teamTitle}</h2>
    <p class="mt-2 text-gray-600">{t.about.teamSub}</p>
    <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        team.map((m) => (
          <li class="rounded-xl border border-gray-200 bg-white p-5 shadow-sm">
            <span class="inline-flex size-10 items-center justify-center rounded-lg bg-brand-50 text-brand-600">
              <Icon name="hard-hat" class="size-5" />
            </span>
            <h3 class="mt-3 text-lg font-semibold text-gray-900">{m.role}</h3>
            {m.showName && <p class="text-sm font-medium text-brand-600">{m.name}</p>}
            {m.qualifications && m.qualifications.length > 0 && (
              <ul class="mt-3 list-disc space-y-1 pl-5 text-sm text-gray-600">
                {m.qualifications.map((q) => <li>{q}</li>)}
              </ul>
            )}
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Office -->
  <section class="bg-gray-50">
    <div class="mx-auto max-w-6xl px-4 py-14">
      <h2 class="text-2xl font-bold text-gray-900 sm:text-3xl">{t.about.officeTitle}</h2>
      <p class="mt-2 text-gray-600">{t.about.officeSub}</p>
      <div class="mt-8 grid gap-3 sm:grid-cols-2">
        {wide.map((item) => <GalleryImage item={item} group="office" aspect="aspect-[21/9]" />)}
      </div>
      <div class="mt-3 grid gap-3 sm:grid-cols-3">
        {small.map((item) => <GalleryImage item={item} group="office" />)}
      </div>
    </div>
  </section>

  <CtaBand />
  <Lightbox />
</Base>
